<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Select Difficulty"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Easy Difficulty Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/easyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/easyIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/ic_target"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/difficulty_easy" />

                    <TextView
                        android:id="@+id/easyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Easy"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/difficulty_easy"
                        app:layout_constraintEnd_toStartOf="@+id/easyMultiplier"
                        app:layout_constraintStart_toEndOf="@+id/easyIcon"
                        app:layout_constraintTop_toTopOf="@+id/easyIcon" />

                    <TextView
                        android:id="@+id/easySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Start your journey"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@+id/easyTitle"
                        app:layout_constraintTop_toBottomOf="@+id/easyTitle" />

                    <TextView
                        android:id="@+id/easyMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1x"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/easyIcon" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/easyDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/easySubtitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/easyDivider">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Base Points"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100 per hit"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time Limit"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1:00"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Score Multiplier"
                                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1x"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Medium Difficulty Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mediumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/easyCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/mediumIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/ic_flash"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/difficulty_medium" />

                    <TextView
                        android:id="@+id/mediumTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Medium"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/difficulty_medium"
                        app:layout_constraintEnd_toStartOf="@+id/mediumMultiplier"
                        app:layout_constraintStart_toEndOf="@+id/mediumIcon"
                        app:layout_constraintTop_toTopOf="@+id/mediumIcon" />

                    <TextView
                        android:id="@+id/mediumSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Challenge yourself"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@+id/mediumTitle"
                        app:layout_constraintTop_toBottomOf="@+id/mediumTitle" />

                    <TextView
                        android:id="@+id/mediumMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2x"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/mediumIcon" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/mediumDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/mediumSubtitle" />

                    <TextView
                        android:id="@+id/mediumBasePointsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base Points"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/mediumDivider"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/mediumBasePoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 per hit"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@id/mediumBasePointsLabel"
                        app:layout_constraintTop_toBottomOf="@id/mediumBasePointsLabel" />

                    <TextView
                        android:id="@+id/mediumTimeLimitLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Limit"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/mediumBasePointsLabel" />

                    <TextView
                        android:id="@+id/mediumTimeLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:00"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@id/mediumTimeLimitLabel"
                        app:layout_constraintTop_toBottomOf="@id/mediumTimeLimitLabel" />

                    <TextView
                        android:id="@+id/mediumScoreMultiplierLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score Multiplier"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/mediumBasePointsLabel" />

                    <TextView
                        android:id="@+id/mediumScoreMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2x"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintEnd_toEndOf="@id/mediumScoreMultiplierLabel"
                        app:layout_constraintTop_toBottomOf="@id/mediumScoreMultiplierLabel" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@id/mediumCard">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/hardIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="TODO"
                        android:src="@drawable/ic_crown"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/difficulty_hard" />

                    <TextView
                        android:id="@+id/hardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Hard"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/difficulty_hard"
                        app:layout_constraintEnd_toStartOf="@+id/hardMultiplier"
                        app:layout_constraintStart_toEndOf="@+id/hardIcon"
                        app:layout_constraintTop_toTopOf="@+id/hardIcon" />

                    <TextView
                        android:id="@+id/hardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Test your limits"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@+id/hardTitle"
                        app:layout_constraintTop_toBottomOf="@+id/hardTitle" />

                    <TextView
                        android:id="@+id/hardMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3x"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/hardIcon" />

                    <com.google.android.material.divider.MaterialDivider
                        android:id="@+id/hardDivider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/hardSubtitle" />

                    <TextView
                        android:id="@+id/hardBasePointsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base Points"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/hardDivider"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/hardBasePoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 per hit"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@id/hardBasePointsLabel"
                        app:layout_constraintTop_toBottomOf="@id/hardBasePointsLabel" />

                    <TextView
                        android:id="@+id/hardTimeLimitLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Limit"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/hardBasePointsLabel" />

                    <TextView
                        android:id="@+id/hardTimeLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:00"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintStart_toStartOf="@id/hardTimeLimitLabel"
                        app:layout_constraintTop_toBottomOf="@id/hardTimeLimitLabel" />

                    <TextView
                        android:id="@+id/hardScoreMultiplierLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Score Multiplier"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/hardBasePointsLabel" />

                    <TextView
                        android:id="@+id/hardScoreMultiplier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3x"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        app:layout_constraintEnd_toEndOf="@id/hardScoreMultiplierLabel"
                        app:layout_constraintTop_toBottomOf="@id/hardScoreMultiplierLabel" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
    <!-- Footer Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="Score = Base Points × Difficulty Multiplier × Combo Bonus\nAdditional sequence for perfect timing and complete"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>